---
import type { SiteEntry } from "../lib/content";
import { withBase } from "../lib/site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: SiteEntry;
  sectionLabel: string;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { entry, sectionLabel, headings = [] } = Astro.props;
const sectionHref = withBase(`${entry.collection}/`);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="content-detail-shell">
    <article class="content-detail">
      <a class="back-link" href={sectionHref}>返回{sectionLabel}</a>
      <header class="article-header">
        <p class="eyebrow">{sectionLabel} / {entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        {
          (entry.data.series || entry.data.topic) && (
            <p class="content-detail__taxonomy">
              {entry.data.series && (
                <span>
                  系列：{entry.data.series}
                  {entry.data.seriesOrder !== undefined ? ` #${entry.data.seriesOrder}` : ""}
                </span>
              )}
              {entry.data.topic && <span>主题：{entry.data.topic}</span>}
            </p>
          )
        }
        <p class="lead">{entry.data.description}</p>
        <div class="content-detail__meta">
          <time datetime={entry.data.pubDate.toISOString()}>
            发布于 {entry.data.pubDate.toLocaleDateString("zh-CN")}
          </time>
          {
            entry.data.updatedDate && (
              <time datetime={entry.data.updatedDate.toISOString()}>
                更新于 {entry.data.updatedDate.toLocaleDateString("zh-CN")}
              </time>
            )
          }
        </div>
      </header>
      <div class="prose content-body">
        <slot />
      </div>
    </article>
    {
      tocHeadings.length > 1 && (
        <aside class="content-toc" aria-label="文章目录">
          <p>目录</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a
                class={`content-toc__link content-toc__link--depth-${heading.depth}`}
                data-toc-link
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>
