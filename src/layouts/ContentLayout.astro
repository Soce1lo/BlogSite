---
import { isPublicEntry, type SiteEntry } from "../lib/content";
import { discussionTerm, resolveEngagementConfig } from "../lib/engagement";
import { prefixBaseInHtmlImageSources, withBase } from "../lib/site";
import type { RelatedReadingEntry } from "../lib/related";
import type { SeriesNavigation } from "../lib/series";
import BaseLayout from "./BaseLayout.astro";
import RelatedReadingComponent from "../components/RelatedReading.astro";
import SeriesNavigationComponent from "../components/SeriesNavigation.astro";
import GitHubComments from "../components/GitHubComments.astro";
import VisitorCount from "../components/VisitorCount.astro";

interface Props {
  entry: SiteEntry;
  sectionLabel: string;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  seriesNavigation?: SeriesNavigation;
  relatedReading?: RelatedReadingEntry[];
}

const { entry, sectionLabel, headings = [], seriesNavigation, relatedReading = [] } = Astro.props;
const engagementAllowed = isPublicEntry(entry);
const { goatcounter, giscus } = resolveEngagementConfig(import.meta.env);
const giscusBacklink = engagementAllowed && giscus && Astro.site && Astro.site.hostname !== "example.com"
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const sectionHref = withBase(`${entry.collection}/`);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const bodyHtml = prefixBaseInHtmlImageSources(
  stripLeadingDuplicateH1(await Astro.slots.render("default"), entry.data.title),
);

function stripLeadingDuplicateH1(html: string, title: string): string {
  const leadingH1Pattern = /^\s*<h1(?:\s[^>]*)?>([\s\S]*?)<\/h1>\s*/i;
  const match = html.match(leadingH1Pattern);

  if (!match) {
    return html;
  }

  return normalizeHtmlText(match[1]) === normalizeHtmlText(title) ? html.slice(match[0].length) : html;
}

function normalizeHtmlText(value: string): string {
  return value
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, "\"")
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  engagementAllowed={engagementAllowed}
  giscusBacklink={giscusBacklink}
>
  <div class="content-detail-shell">
    <article class="content-detail">
      <a class="back-link" href={sectionHref}>返回{sectionLabel}</a>
      <header class="article-header">
        <p class="eyebrow">{sectionLabel} / {entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        {
          (entry.data.series || entry.data.topic) && (
            <p class="content-detail__taxonomy">
              {entry.data.series && (
                <span>
                  系列：{entry.data.series}
                  {entry.data.seriesOrder !== undefined ? ` #${entry.data.seriesOrder}` : ""}
                </span>
              )}
              {entry.data.topic && <span>主题：{entry.data.topic}</span>}
            </p>
          )
        }
        <p class="lead">{entry.data.description}</p>
        <div class="content-detail__meta">
          <time datetime={entry.data.pubDate.toISOString()}>
            发布于 {entry.data.pubDate.toLocaleDateString("zh-CN")}
          </time>
          {
            entry.data.updatedDate && (
              <time datetime={entry.data.updatedDate.toISOString()}>
                更新于 {entry.data.updatedDate.toLocaleDateString("zh-CN")}
              </time>
            )
          }
          {engagementAllowed && goatcounter && <VisitorCount config={goatcounter} scope="page" />}
        </div>
        {seriesNavigation && (
          <SeriesNavigationComponent navigation={seriesNavigation} currentEntry={entry} />
        )}
      </header>
      {
        tocHeadings.length > 1 && (
          <aside class="content-toc" aria-label="文章目录">
            <p>目录</p>
            <nav>
              {tocHeadings.map((heading) => (
                <a
                  class={`content-toc__link content-toc__link--depth-${heading.depth}`}
                  data-toc-link
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
      <div class="prose content-body" set:html={bodyHtml} />
      <RelatedReadingComponent entries={relatedReading} />
      {engagementAllowed && giscus && (
        <GitHubComments config={giscus} term={discussionTerm(entry.collection, entry.id)} />
      )}
    </article>
  </div>
</BaseLayout>
