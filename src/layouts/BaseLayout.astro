---
import { getCollection } from "astro:content";
import "../styles/global.css";
import type { SiteEntry } from "../lib/content";
import { buildSearchItems, serializeForInlineJson } from "../lib/search";
import { withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BlogSite",
  description = "一个用于发布博客、笔记和项目记录的个人站点。",
} = Astro.props;
const pageTitle = title === "BlogSite" ? title : `${title} | BlogSite`;

const [blogEntries, noteEntries, projectEntries] = await Promise.all([
  getCollection("blog"),
  getCollection("notes"),
  getCollection("projects"),
]);
const searchEntries: SiteEntry[] = [...blogEntries, ...noteEntries, ...projectEntries];
const searchItems = buildSearchItems(searchEntries).map((item) => ({
  ...item,
  href: withBase(item.path),
}));
const searchJson = serializeForInlineJson(searchItems);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title="BlogSite RSS" href={withBase("rss.xml")} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("blogsite-theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            document.documentElement.dataset.theme = storedTheme;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-brand">
          <a class="site-title" href={withBase("")}>BlogSite</a>
          <span>公开知识库</span>
        </div>
        <div class="site-navigation">
          <nav aria-label="主导航">
            <a href={withBase("blog/")}>博客</a>
            <a href={withBase("notes/")}>笔记</a>
            <a href={withBase("projects/")}>项目</a>
            <a href={withBase("about/")}>关于</a>
          </nav>
          <div class="site-actions">
            <button class="control-button" type="button" data-search-open aria-label="打开站内搜索">
              搜索
            </button>
            <button class="control-button" type="button" data-theme-toggle aria-label="切换明暗主题">
              <span data-theme-label>主题</span>
            </button>
          </div>
        </div>
      </div>
    </header>
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <p>内容以静态页面发布。<a href={withBase("rss.xml")}>订阅 RSS</a></p>
    </footer>
    <div class="search-panel" data-search-panel hidden>
      <section class="search-dialog" role="dialog" aria-modal="true" aria-label="站内搜索">
        <div class="search-dialog__header">
          <label class="search-field">
            <span>搜索</span>
            <input
              type="search"
              data-search-input
              autocomplete="off"
              placeholder="标题、摘要、标签"
            />
          </label>
          <button class="control-button" type="button" data-search-close aria-label="关闭搜索">
            关闭
          </button>
        </div>
        <ol class="search-results" data-search-results></ol>
      </section>
    </div>
    <script is:inline id="site-search-data" type="application/json" set:html={searchJson}></script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector("[data-theme-toggle]");
        const themeLabel = document.querySelector("[data-theme-label]");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

        const getCurrentTheme = () => {
          if (root.dataset.theme === "light" || root.dataset.theme === "dark") {
            return root.dataset.theme;
          }
          return prefersDark.matches ? "dark" : "light";
        };

        const updateThemeLabel = () => {
          if (!themeLabel) return;
          themeLabel.textContent = getCurrentTheme() === "dark" ? "亮色" : "暗色";
        };

        themeButton?.addEventListener("click", () => {
          const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
          root.dataset.theme = nextTheme;
          try {
            localStorage.setItem("blogsite-theme", nextTheme);
          } catch {}
          updateThemeLabel();
        });
        prefersDark.addEventListener?.("change", updateThemeLabel);
        updateThemeLabel();

        const searchPanel = document.querySelector("[data-search-panel]");
        const searchInput = document.querySelector("[data-search-input]");
        const searchResults = document.querySelector("[data-search-results]");
        const searchOpen = document.querySelector("[data-search-open]");
        const searchClose = document.querySelector("[data-search-close]");
        const dataNode = document.getElementById("site-search-data");
        let searchItems = [];

        try {
          searchItems = JSON.parse(dataNode?.textContent || "[]");
        } catch {
          searchItems = [];
        }

        const normalize = (value) => value.toLowerCase().trim();

        const renderResults = () => {
          if (!searchResults || !searchInput) return;
          const query = normalize(searchInput.value);
          const matches = (query
            ? searchItems.filter((item) =>
                normalize(
                  [
                    item.title,
                    item.description,
                    item.section,
                    item.category,
                    ...(item.tags || []),
                  ].join(" "),
                ).includes(query),
              )
            : searchItems
          ).slice(0, 8);

          searchResults.textContent = "";
          if (matches.length === 0) {
            const empty = document.createElement("li");
            empty.className = "search-empty";
            empty.textContent = "没有匹配内容";
            searchResults.append(empty);
            return;
          }

          for (const item of matches) {
            const row = document.createElement("li");
            const link = document.createElement("a");
            const meta = document.createElement("span");
            const title = document.createElement("strong");
            const description = document.createElement("span");

            link.href = item.href;
            meta.className = "search-results__meta";
            title.className = "search-results__title";
            description.className = "search-results__description";
            meta.textContent = [item.section, item.category].filter(Boolean).join(" / ");
            title.textContent = item.title;
            description.textContent = item.description;
            link.append(meta, title, description);
            row.append(link);
            searchResults.append(row);
          }
        };

        const openSearch = () => {
          if (!searchPanel || !searchInput) return;
          searchPanel.hidden = false;
          document.body.classList.add("search-open");
          renderResults();
          requestAnimationFrame(() => searchInput.focus());
        };

        const closeSearch = () => {
          if (!searchPanel) return;
          searchPanel.hidden = true;
          document.body.classList.remove("search-open");
        };

        searchOpen?.addEventListener("click", openSearch);
        searchClose?.addEventListener("click", closeSearch);
        searchInput?.addEventListener("input", renderResults);
        searchPanel?.addEventListener("click", (event) => {
          if (event.target === searchPanel) closeSearch();
        });
        document.addEventListener("keydown", (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            openSearch();
          }
          if (event.key === "Escape" && searchPanel && !searchPanel.hidden) {
            closeSearch();
          }
        });

        const readingProgress = document.querySelector("[data-reading-progress]");
        const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));
        const tocTargets = tocLinks
          .map((link) => {
            const slug = link.getAttribute("href")?.slice(1);
            return slug ? { link, target: document.getElementById(slug) } : null;
          })
          .filter((item) => item?.target);
        let ticking = false;

        const updateReadingState = () => {
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
          readingProgress?.style.setProperty("--reading-progress", String(progress));

          let activeLink = tocTargets[0]?.link;
          for (const item of tocTargets) {
            if (item.target.offsetTop <= window.scrollY + 112) {
              activeLink = item.link;
            }
          }
          for (const link of tocLinks) {
            const isActive = link === activeLink;
            link.classList.toggle("is-active", isActive);
            link.toggleAttribute("aria-current", isActive);
          }
          ticking = false;
        };

        const requestReadingStateUpdate = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateReadingState);
        };

        if (readingProgress || tocLinks.length > 0) {
          window.addEventListener("scroll", requestReadingStateUpdate, { passive: true });
          window.addEventListener("resize", requestReadingStateUpdate);
          requestReadingStateUpdate();
        }
      })();
    </script>
  </body>
</html>
