---
import type { SiteEntry } from "../lib/content";
import { withBase } from "../lib/site";
import { tagId } from "../lib/tags";

interface Props {
  entries: SiteEntry[];
  emptyMessage?: string;
  headingLevel?: 2 | 3;
}

const { entries, emptyMessage = "暂无公开内容。", headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
---

{
  entries.length === 0 ? (
    <p class="empty-state">{emptyMessage}</p>
  ) : (
    <ol class="content-list">
      {entries.map((entry) => (
        <li class="content-card">
          <p class="content-card__meta">
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString("zh-CN")}
            </time>
            {entry.data.topic && <span>{entry.data.topic}</span>}
          </p>
          <div class="content-card__body">
            <Heading class="content-card__title">
              <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                {entry.data.title}
              </a>
            </Heading>
            <p class="content-card__description">{entry.data.description}</p>
            {!entry.data.topic && entry.data.tags.length > 0 && (
              <ul class="tag-list" aria-label="标签">
                {entry.data.tags.slice(0, 2).map((tag) => (
                  <li>
                    <a href={`${withBase("tags/")}#${tagId(tag)}`}>{tag}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}
