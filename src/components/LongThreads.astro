---
import type { ResolvedThread } from "../lib/output";
import { getPublishedDate } from "../lib/content";
import { withBase } from "../lib/site";

interface Props {
  threads: ResolvedThread[];
}

const { threads } = Astro.props;
---

<ol class="long-threads">
  {
    threads.map((thread) => (
      <li class="long-thread" id={`thread-${thread.id}`}>
        <header class="long-thread__identity">
          <p class="long-thread__meta">
            {thread.entries.length} 条记录
            <span aria-hidden="true">·</span>
            最近发布于
            <time datetime={thread.latestPublishedDate.toISOString()}>
              {thread.latestPublishedDate.toLocaleDateString("zh-CN")}
            </time>
          </p>
          <h3>{thread.label}</h3>
          <p>{thread.description}</p>
        </header>
        <div>
          <ol class="long-thread__entries">
            {thread.entries.slice(0, 3).map((entry) => (
              <li>
                <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                  <span>{entry.data.title}</span>
                  <time datetime={getPublishedDate(entry).toISOString()}>
                    {getPublishedDate(entry).toLocaleDateString("zh-CN", {
                      year: "numeric",
                      month: "2-digit",
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ol>
          <a
            class="text-link"
            href={withBase(`explore/${thread.id}/`)}
            aria-label={`查看全部 ${thread.entries.length} 篇（${thread.label}）`}
          >查看全部 {thread.entries.length} 篇 <span aria-hidden="true">→</span></a>
        </div>
      </li>
    ))
  }
</ol>
