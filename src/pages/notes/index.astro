---
import { getCollection } from "astro:content";
import ContentList from "../../components/ContentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicEntry, sortNewestFirst } from "../../lib/content";

const entries = (await getCollection("notes")).filter(isPublicEntry).sort(sortNewestFirst);
---

<BaseLayout title="学习" description="Soce1lo 已经形成并愿意公开的技术理解。">
  <header class="page-heading">
    <p class="eyebrow">Learned</p>
    <h1>学习</h1>
    <p>已经自洽、可复用，并且可以继续修订的技术理解。</p>
  </header>
  <ContentList entries={entries} />
</BaseLayout>
