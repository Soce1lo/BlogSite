---
import { getCollection } from "astro:content";
import ContentList from "../../components/ContentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicEntry, sortNewestFirst } from "../../lib/content";

const entries = (await getCollection("notes")).filter(isPublicEntry).sort(sortNewestFirst);
---

<BaseLayout title="笔记" description="BlogSite 的公开笔记。">
  <header class="page-heading">
    <p class="eyebrow">Notes</p>
    <h1>笔记</h1>
    <p>简短、聚焦并可持续更新的公开知识片段。</p>
  </header>
  <ContentList entries={entries} />
</BaseLayout>

