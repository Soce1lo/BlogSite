---
import { getCollection } from "astro:content";
import ContentList from "../../components/ContentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicEntry, sortNewestFirst } from "../../lib/content";

const entries = (await getCollection("blog")).filter(isPublicEntry).sort(sortNewestFirst);
---

<BaseLayout title="思考" description="Soce1lo 经过整理的思考、经历与复盘。">
  <header class="page-heading">
    <p class="eyebrow">Thoughts</p>
    <h1>思考</h1>
    <p>从经历、判断和实践中沉淀出的长文与复盘。</p>
  </header>
  <ContentList entries={entries} />
</BaseLayout>
