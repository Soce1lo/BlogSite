---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildExploreItems,
  exploreCollections,
  filterExploreItems,
  readExploreFilters,
} from "../../lib/explore";
import { withBase } from "../../lib/site";
import "../../styles/explore.css";

const [blog, notes, projects] = await Promise.all([
  getCollection("blog"),
  getCollection("notes"),
  getCollection("projects"),
]);
const items = filterExploreItems(
  buildExploreItems([...blog, ...notes, ...projects]),
  readExploreFilters(new URLSearchParams()),
);
const topics = [...new Set(items.map((item) => item.topic).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b, "zh-CN"));
const years = [...new Set(items.map((item) => item.year))].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="探索档案" description="搜索和筛选 Soce1lo 的思考、学习笔记与项目记录。">
  <header class="page-heading explore-heading">
    <p class="eyebrow">EXPLORER / 公开记录</p>
    <h1>探索档案</h1>
    <p>按主题、年份或关键词查找思考、学习笔记和项目记录。</p>
  </header>

  <div class="explore" data-explore>
    <form class="explore-filters" aria-label="筛选档案" autocomplete="off" data-explore-filters hidden>
      <label class="explore-field">
        <span>关键词</span>
        <input type="search" name="q" placeholder="如 I2C 或 Obsidian" />
      </label>
      <label class="explore-field">
        <span>类型</span>
        <select name="collection">
          <option value="">全部类型</option>
          {Object.entries(exploreCollections).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label class="explore-field">
        <span>主题</span>
        <select name="topic">
          <option value="">全部主题</option>
          {topics.map((topic) => <option value={topic}>{topic}</option>)}
        </select>
      </label>
      <label class="explore-field">
        <span>年份</span>
        <select name="year">
          <option value="">全部年份</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label class="explore-field">
        <span>排序</span>
        <select name="sort">
          <option value="newest">最新发布</option>
          <option value="oldest">最早发布</option>
        </select>
      </label>
      <button type="button" class="control-button explore-reset" data-explore-reset>重置筛选</button>
    </form>

    <section class="explore-results" aria-label="档案列表">
      <header class="explore-results__header">
        <h2>公开档案</h2>
        <p role="status" aria-live="polite" aria-atomic="true" data-explore-count>共 {items.length} 条</p>
      </header>
      <p class="explore-empty" data-explore-empty hidden={items.length > 0}>
        {items.length > 0 ? "没有符合条件的档案。可调整关键词或重置筛选。" : "暂无公开档案。"}
      </p>
      <ul class="explore-list" role="list" data-explore-list hidden={items.length === 0}>
        {items.map((item) => {
          const date = new Date(item.timestamp).toISOString();
          return (
            <li
              class="explore-row"
              data-path={item.path}
              data-collection={item.collection}
              data-topic={item.topic}
              data-timestamp={item.timestamp}
              data-year={item.year}
              data-search-text={item.searchText}
            >
              <div class="explore-row__stamp">
                <span class="explore-row__kind">{exploreCollections[item.collection]}</span>
                <time datetime={date}>{date.split("T")[0]}</time>
              </div>
              <div class="explore-row__body">
                <h3><a href={withBase(item.path)}>{item.title}</a></h3>
                <p>{item.description}</p>
                {item.topic && <span class="explore-row__topic">{item.topic}</span>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import "../../scripts/explore";
</script>
