---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/site";
---

<BaseLayout title="页面未找到" description="请求的页面不存在或已经移动。" engagementAllowed={false}>
  <section class="not-found">
    <p class="eyebrow">Error / 404</p>
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>这里没有可公开的页面。</h1>
    <p>地址可能有误，或者内容已经移动。可以回到首页，也可以继续浏览公开输出。</p>
    <div class="not-found__actions">
      <a class="action-link action-link--primary" href={withBase("")}>返回首页</a>
      <a class="action-link" href={withBase("blog/")}>浏览思考</a>
      <a class="action-link" href={withBase("tags/")}>查看主题</a>
    </div>
  </section>
</BaseLayout>
