---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SiteEntry } from "../../lib/content";
import { buildTagGroups } from "../../lib/tags";
import { withBase } from "../../lib/site";

const [blogEntries, noteEntries, projectEntries] = await Promise.all([
  getCollection("blog"),
  getCollection("notes"),
  getCollection("projects"),
]);
const entries: SiteEntry[] = [...blogEntries, ...noteEntries, ...projectEntries];
const groups = buildTagGroups(entries);
const tagCloud = [...groups]
  .sort((a, b) => b.entries.length - a.entries.length || a.name.localeCompare(b.name, "zh-CN"))
  .slice(0, 12);
---

<BaseLayout title="主题" description="按主题浏览 Soce1lo 的公开输出。">
  <header class="page-heading">
    <p class="eyebrow">Index / Topics</p>
    <h1>主题</h1>
    <p>从主题词进入思考、学习和项目记录。这里只索引公开输出。</p>
  </header>

  {
    groups.length === 0 ? (
      <p class="empty-state">暂无公开主题。</p>
    ) : (
      <>
        <nav class="tag-cloud" aria-label="常用主题">
          {tagCloud.map((group) => (
            <a
              class={`tag-cloud__item tag-cloud__item--count-${Math.min(group.entries.length, 4)}`}
              href={`#${group.id}`}
            >
              <span>#{group.name}</span>
              <small>{group.entries.length} 篇</small>
            </a>
          ))}
        </nav>
        <div class="tag-directory">
          {groups.map((group) => (
            <section class="tag-group" id={group.id}>
              <header class="tag-group__header">
                <h2>#{group.name}</h2>
                <span>{group.entries.length} 篇</span>
              </header>
              <ol class="tag-group__entries">
                {group.entries.map((entry) => (
                  <li>
                    <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                      <span>{entry.data.title}</span>
                      <time datetime={entry.data.pubDate.toISOString()}>
                        {entry.data.pubDate.toLocaleDateString("zh-CN")}
                      </time>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
