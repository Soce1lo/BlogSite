---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { SiteEntry } from "../lib/content";
import { isPublicEntry, sortNewestFirst } from "../lib/content";
import { withBase } from "../lib/site";

const [blog, notes, projects] = await Promise.all([
  getCollection("blog"),
  getCollection("notes"),
  getCollection("projects"),
]);

const publicBlog = blog.filter(isPublicEntry).sort(sortNewestFirst);
const publicNotes = notes.filter(isPublicEntry).sort(sortNewestFirst);
const publicProjects = projects.filter(isPublicEntry).sort(sortNewestFirst);
const recentEntries: SiteEntry[] = [...publicBlog, ...publicNotes, ...publicProjects]
  .sort(sortNewestFirst)
  .slice(0, 3);
const sectionLabels: Record<SiteEntry["collection"], string> = {
  blog: "博客",
  notes: "笔记",
  projects: "项目",
};
const sections = [
  {
    key: "blog",
    index: "01",
    title: "博客",
    description: "围绕一个主题展开的完整文章与实践总结。",
    href: "blog/",
    entries: publicBlog.slice(0, 3),
    total: publicBlog.length,
  },
  {
    key: "notes",
    index: "02",
    title: "笔记",
    description: "短篇观察、方法和持续维护的知识片段。",
    href: "notes/",
    entries: publicNotes.slice(0, 3),
    total: publicNotes.length,
  },
  {
    key: "projects",
    index: "03",
    title: "项目",
    description: "正在建设或已经完成的公开项目记录。",
    href: "projects/",
    entries: publicProjects.slice(0, 3),
    total: publicProjects.length,
  },
];
const homeStats = sections.map((section) => ({
  label: section.title,
  value: section.total,
  href: section.href,
}));
---

<BaseLayout>
  <section class="home-intro">
    <div class="home-intro__copy">
      <p class="eyebrow">BlogSite / 公开知识库</p>
      <h1>把本地知识整理成<br />值得公开的文本。</h1>
      <p>
        这里收录经过筛选的技术实践、知识笔记和项目记录。保留清晰来源，
        也保留继续修订的空间。
      </p>
      <ul class="home-stats" aria-label="公开内容计数">
        {
          homeStats.map((stat) => (
            <li>
              <a href={withBase(stat.href)}>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="text-link" href={withBase("rss.xml")}>订阅 RSS <span aria-hidden="true">↗</span></a>
    </div>

    <aside class="recent-stream" aria-labelledby="recent-heading">
      <header>
        <p class="eyebrow">Latest signal</p>
        <h2 id="recent-heading">最近更新</h2>
      </header>
      <ol>
        {
          recentEntries.map((entry) => (
            <li>
              <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                <span class="recent-stream__meta">
                  <time datetime={entry.data.pubDate.toISOString()}>
                    {entry.data.pubDate.toLocaleDateString("zh-CN")}
                  </time>
                  <span>{sectionLabels[entry.collection]}</span>
                </span>
                <strong>{entry.data.title}</strong>
              </a>
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <div class="collection-index" aria-label="内容分类">
    {
      sections.map((section) => (
        <section class="collection-row">
          <header class="collection-row__label">
            <span>{section.index}</span>
            <div>
              <h2><a href={withBase(section.href)}>{section.title}</a></h2>
              <p>{section.description}</p>
            </div>
            <a class="collection-row__count" href={withBase(section.href)}>
              {section.total} 篇
            </a>
          </header>
          {section.entries.length === 0 ? (
            <p class="empty-state">暂无公开内容。</p>
          ) : (
            <ol class="collection-row__entries">
              {section.entries.map((entry) => (
                <li>
                  <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                    <span>{entry.data.title}</span>
                    <time datetime={entry.data.pubDate.toISOString()}>
                      {entry.data.pubDate.toLocaleDateString("zh-CN")}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
