---
import { getCollection } from "astro:content";
import LongThreads from "../components/LongThreads.astro";
import OutputLog from "../components/OutputLog.astro";
import LabMap from "../components/LabMap.astro";
import { siteProfile } from "../data/site-profile";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedDate, isPublicEntry, sortNewestFirst, type SiteEntry } from "../lib/content";
import {
  buildOutputGroups,
  getOutputKind,
  getPrimaryTopic,
  resolveFeaturedEntries,
  resolveThreads,
} from "../lib/output";
import { withBase } from "../lib/site";
import "../styles/lab.css";

const [blog, notes, projects] = await Promise.all([
  getCollection("blog"),
  getCollection("notes"),
  getCollection("projects"),
]);
const entries: SiteEntry[] = [...blog, ...notes, ...projects];
const publicEntries = entries.filter(isPublicEntry).sort(sortNewestFirst);
const latestEntry = publicEntries[0];
const outputGroups = buildOutputGroups(entries, 4);
const earlierEntries = buildOutputGroups(entries, entries.length)
  .flatMap((group) => group.entries)
  .slice(4);
const earlierOutputGroups = buildOutputGroups(earlierEntries, earlierEntries.length);
const threads = resolveThreads(entries, siteProfile.threads);
const featured = resolveFeaturedEntries(entries, siteProfile.featured);
const kindLabels = {
  thought: "思考",
  learned: "学习",
  built: "构建",
  revised: "修订",
};
---

<BaseLayout description={siteProfile.description}>
  <div class="lab-masthead" aria-label="网站介绍">
    <span>学习、实践与思考</span>
    <span>CURIOSITY · SYSTEMS · PRACTICE</span>
  </div>
  <section class="growth-hero">
    <div class="growth-hero__copy">
      <p class="eyebrow">{siteProfile.eyebrow}</p>
      <h1>{siteProfile.title}</h1>
      <p>{siteProfile.description}</p>
      <div class="growth-hero__actions">
        <a class="lab-button" href={withBase("explore/")}>探索全部记录 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={featured.length > 0 ? "#selected-heading" : withBase("about/")}>从这里开始 <span aria-hidden="true">↓</span></a>
      </div>
      <div class="lab-identity">
        <span class="lab-identity__mark" aria-hidden="true">S<span>·</span></span>
        <div><strong>Soce1lo</strong><span>软件工程师</span></div>
        <a href={withBase("about/")} aria-label="认识 Soce1lo">认识我 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <LabMap threads={threads} />
  </section>

  <aside class="lab-status" aria-label="公开记录概况">
    <p><span class="lab-status__dot" aria-hidden="true"></span>持续积累，保持可修订</p>
    <a href={withBase("explore/")}>{publicEntries.length} 篇公开记录 <span aria-hidden="true">↗</span></a>
    {latestEntry && <p>最近发布 <time datetime={getPublishedDate(latestEntry).toISOString()}>{getPublishedDate(latestEntry).toISOString().slice(0, 10)}</time></p>}
  </aside>

  <div class="lab-workbench">
    <section class="output-section" aria-labelledby="output-heading">
      <header class="home-section-heading">
        <p class="eyebrow">OUTPUT LOG</p>
        <h2 id="output-heading">最近输出</h2>
        <p>想明白的事、学会的方法，以及做出的项目。</p>
      </header>
      {
        outputGroups.length > 0
          ? <OutputLog groups={outputGroups} />
          : <p class="empty-state">暂无公开输出。</p>
      }
      {earlierOutputGroups.length > 0 && (
        <details class="output-history">
          <summary>
            <span class="output-history__show">查看更早的输出</span>
            <span class="output-history__hide">收起更早的输出</span>
          </summary>
          <OutputLog groups={earlierOutputGroups} />
        </details>
      )}
      <a class="text-link" href={withBase("explore/")}>在档案中查找 <span aria-hidden="true">↗</span></a>
    </section>

    <aside class="lab-notebook" aria-labelledby="notebook-heading">
      <p class="eyebrow">WORKING PRINCIPLE</p>
      <h2 id="notebook-heading">让想法经过现实。</h2>
      <ol>
        <li><span>提问</span><p>先看约束，把未知说清楚。</p></li>
        <li><span>验证</span><p>用足够小的实验，检验理解。</p></li>
        <li><span>留痕</span><p>留下证据、取舍和可复用的方法。</p></li>
      </ol>
      <a class="text-link" href={withBase("about/")}>我的工作方式 <span aria-hidden="true">↗</span></a>
      <div class="lab-subscribe">
        <span aria-hidden="true">↳</span>
        <p>让新的记录自己抵达。<a href={withBase("rss.xml")}>通过 RSS 订阅</a></p>
      </div>
    </aside>
  </div>

  {
    featured.length > 0 && (
      <section class="selected-section" aria-labelledby="selected-heading">
        <header class="home-section-heading">
          <p class="eyebrow">SELECTED / 精选</p>
          <h2 id="selected-heading">从这几篇开始</h2>
        </header>
        <ol class="selected-list">
          {featured.map((entry) => (
            <li>
              <a href={withBase(`${entry.collection}/${entry.id}/`)}>
                <p class="selected-list__meta">
                  <span>{kindLabels[getOutputKind(entry)]}</span>
                  <span>{getPrimaryTopic(entry)}</span>
                  <time datetime={getPublishedDate(entry).toISOString()}>
                    {getPublishedDate(entry).toLocaleDateString("zh-CN")}
                  </time>
                </p>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    threads.length > 0 && (
      <section class="threads-section" aria-labelledby="threads-heading">
        <header class="home-section-heading">
          <p class="eyebrow">LONG THREADS / 长期主题</p>
          <h2 id="threads-heading">持续追踪的问题</h2>
        </header>
        <LongThreads threads={threads} />
      </section>
    )
  }

  <section class="archive-section" aria-labelledby="archive-heading">
    <header class="home-section-heading">
      <p class="eyebrow">ARCHIVE / 档案</p>
      <h2 id="archive-heading">继续浏览</h2>
    </header>
    <nav class="archive-links" aria-label="内容档案">
      <a href={withBase("explore/")}>探索全部 <span aria-hidden="true">↗</span></a>
      <a href={withBase("blog/")}>思考 <span aria-hidden="true">↗</span></a>
      <a href={withBase("notes/")}>学习 <span aria-hidden="true">↗</span></a>
      <a href={withBase("projects/")}>项目 <span aria-hidden="true">↗</span></a>
      <a href={withBase("tags/")}>主题 <span aria-hidden="true">↗</span></a>
      <a href={withBase("rss.xml")}>RSS <span aria-hidden="true">↗</span></a>
    </nav>
  </section>
</BaseLayout>
