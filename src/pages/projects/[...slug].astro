---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { isGeneratedEntry } from "../../lib/content";
import { resolveSeriesNavigation, type SeriesNavigation } from "../../lib/series";

export async function getStaticPaths() {
  const [blogEntries, noteEntries, projectEntries] = await Promise.all([
    getCollection("blog"),
    getCollection("notes"),
    getCollection("projects"),
  ]);
  const entries = projectEntries.filter(isGeneratedEntry);
  const allEntries = [
    ...blogEntries.filter(isGeneratedEntry),
    ...noteEntries.filter(isGeneratedEntry),
    ...entries,
  ];

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, seriesNavigation: resolveSeriesNavigation(entry, allEntries) },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
  seriesNavigation?: SeriesNavigation;
}

const { entry, seriesNavigation } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  entry={entry}
  sectionLabel="项目"
  headings={headings}
  seriesNavigation={seriesNavigation}
>
  <Content />
</ContentLayout>
