---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { isGeneratedEntry, isPublicEntry } from "../../lib/content";
import { resolveRelatedReading, type RelatedReadingEntry } from "../../lib/related";
import { resolveSeriesNavigation, type SeriesNavigation } from "../../lib/series";

export async function getStaticPaths() {
  const [blogEntries, noteEntries, projectEntries] = await Promise.all([
    getCollection("blog"),
    getCollection("notes"),
    getCollection("projects"),
  ]);
  const entries = projectEntries.filter(isGeneratedEntry);
  const allEntries = [
    ...blogEntries.filter(isGeneratedEntry),
    ...noteEntries.filter(isGeneratedEntry),
    ...entries,
  ];
  const publicEntries = allEntries.filter(isPublicEntry);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      seriesNavigation: resolveSeriesNavigation(entry, allEntries),
      relatedReading: resolveRelatedReading(entry, publicEntries),
    },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
  seriesNavigation?: SeriesNavigation;
  relatedReading?: RelatedReadingEntry[];
}

const { entry, seriesNavigation, relatedReading = [] } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  entry={entry}
  sectionLabel="项目"
  headings={headings}
  seriesNavigation={seriesNavigation}
  relatedReading={relatedReading}
>
  <Content />
</ContentLayout>
