---
import { getCollection } from "astro:content";
import ContentList from "../../components/ContentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicEntry, sortNewestFirst } from "../../lib/content";

const entries = (await getCollection("projects")).filter(isPublicEntry).sort(sortNewestFirst);
---

<BaseLayout title="项目" description="Soce1lo 的公开项目与阶段复盘。">
  <header class="page-heading">
    <p class="eyebrow">Projects</p>
    <h1>项目</h1>
    <p>项目目标、关键决策、实施结果和阶段复盘。</p>
  </header>
  <ContentList entries={entries} />
</BaseLayout>
